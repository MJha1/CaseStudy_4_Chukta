# Copy this file to `.env` in packages/db and paste your Neon connection strings.
# Prisma reads these for generate / db push / seed. This file is gitignored.
#
# Neon gives you a pooled and a direct URL:
#  - DATABASE_URL: the POOLED endpoint (host contains "-pooler"). Used by the app.
#  - DIRECT_URL:   the DIRECT endpoint (same host WITHOUT "-pooler"). Used for schema
#                  changes (prisma db push / migrate), which don't work over PgBouncer.

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
