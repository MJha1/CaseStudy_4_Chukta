// Chukta database schema.
// Rows belong to either a signed-in User (userId) or an anonymous guest device
// (deviceId, userId null). Signing in claims a device's rows into the user.
// Enum-like fields are stored as strings and validated at the API boundary by
// the @chukta/shared Zod schemas.

generator client {
  provider      = "prisma-client-js"
  // native = local dev; debian target covers Railway's Linux runtime.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  googleSub String   @unique
  email     String
  name      String?
  picture   String?
  createdAt DateTime @default(now())
}

model Vehicle {
  id           String    @id @default(cuid())
  deviceId     String? // set for guest-owned rows
  userId       String? // set for signed-in-user-owned rows
  plate        String
  model        String?
  vehicleClass String? // 'LMV' | '2W' | 'GOODS' | 'TRANSPORT'
  soldDate     String? // ISO date; presence => "sold" checks apply
  isSample     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  challans     Challan[]

  @@index([deviceId])
  @@index([userId])
}

model Challan {
  id           String   @id @default(cuid())
  deviceId     String?
  userId       String?
  vehicleId    String
  offence      String
  section      String?
  amount       Int
  date         String // ISO date
  location     String?
  city         String?
  evidenceNote String?
  isPaid       Boolean  @default(false) // status is otherwise derived from date
  flag         String? // 'classMismatch' | 'sold' | 'duplicate'
  isSample     Boolean  @default(false)
  createdAt    DateTime @default(now())
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([userId])
  @@index([vehicleId])
}

model Dispute {
  id            String   @id @default(cuid())
  deviceId      String?
  userId        String?
  plate         String
  challanNo     String?
  offence       String
  amount        Int
  date          String // ISO date of the challan
  city          String?
  location      String?
  ground        String // GroundKey
  note          String?
  saleDate      String?
  receipt       String?
  name          String?
  mobile        String?
  hasScreenshot Boolean  @default(false)
  letter        String
  filed         Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([deviceId])
  @@index([userId])
}
