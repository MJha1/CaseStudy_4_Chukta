# Chukta API — environment variables.
# Copy to apps/api/.env for local dev (git-ignored), or set these on Railway.
# DATABASE_URL / SESSION_JWT_SECRET / GOOGLE_CLIENT_ID live in packages/db/.env.

# --- Live challan-data provider (eChallan.app) -----------------------------
# Set CHALLAN_PROVIDER_KEY to activate the live "eChallan.app" provider (free
# developer signup — no wallet or KYC). Until it is set, the app uses the
# clearly-labelled simulated demo vendors. A live lookup still requires the
# customer's on-screen consent.
#   Sign up: https://echallan.app/developer-api  (Create Developer Account -> Generate API Keys)
CHALLAN_PROVIDER_KEY=

# Optional overrides (sensible defaults are used if omitted):
# CHALLAN_PROVIDER_URL=https://production.echallan.app/v1
# CHALLAN_PROVIDER_NAME=eChallan.app
